{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "target": "ESNext",
    "resolveJsonModule": true,
    "paths": {
      "@root": ["./src"],
      "@root/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"]
}
